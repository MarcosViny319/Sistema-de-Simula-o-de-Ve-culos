package com.mycompany.simulacaoveiculos;

public class Garagem {
    private Veiculo[] veiculos;
    private int quantidade;
    public Garagem(int tamanho) {
        veiculos = new Veiculo[tamanho];
        quantidade = 0;
    }
    public void adicionarVeiculo(Veiculo v) {
        if (quantidade < veiculos.length) {
            veiculos[quantidade] = v;
            quantidade++;
            System.out.println("Veiculo adicionado!");
        } else {
            System.out.println("Garagem cheia!");
        }
    }
    public void listarVeiculos() {
        if (quantidade == 0) {
            System.out.println("Nenhum veiculo na garagem.");
        } else {
            for (int i = 0; i < quantidade; i++) {
                System.out.println(veiculos[i]);
            }
        }
    }
}
