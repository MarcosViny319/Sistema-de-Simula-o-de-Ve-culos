package com.mycompany.simulacaoveiculos;

public class SimuladorDeTrafego {

    private Veiculo[] pista;
    private int quantidade;
    public SimuladorDeTrafego(int tamanho) {
        pista = new Veiculo[tamanho];
        quantidade = 0;
    }
    public void adicionarVeiculo(Veiculo v) {
        if (quantidade < pista.length) {
            pista[quantidade] = v;
            quantidade++;
        }
    }
    public void simularInteracoes() {
        for (int i = 0; i < quantidade - 1; i++) {
            pista[i].interagir(
                    pista[i + 1]
            );
        }
    }
    public void exibirConsumos() {
        for (int i = 0; i < quantidade; i++) {
            System.out.println(
                    pista[i].getModelo()
                    + " consumo: "
                    + pista[i].calcularConsumo()
                    + " km/l"
            );
        }
    }
}
